// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — TRP Digitals Analytics
// ─────────────────────────────────────────────────────────────────────────────
// DATA RETENTION POLICY:
//   - AnalyticsEvent (raw events): Purged after 90 days by the daily cron job
//   - AnalyticsDaily (aggregated): Kept indefinitely
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Raw page-view events — purged after 90 days, never stores IP or PII
model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventId    String?  // Client-generated UUID for idempotency
  visitorId  String   // Anonymous UUID in 1-year cookie
  sessionId  String   // Anonymous UUID in 30-min cookie
  eventType  String   @default("PAGE_VIEW") // "PAGE_VIEW" | "CTA_CLICK" | etc.
  pathname   String
  referrer   String?  // Stripped to origin only
  deviceType String?  // "desktop" | "mobile" | "tablet"
  browser    String?
  os         String?
  country    String?  // From Vercel x-vercel-ip-country header
  region     String?  // From Vercel x-vercel-ip-country-region header
  city       String?  // From Vercel x-vercel-ip-city header
  isBot      Boolean  @default(false)
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([pathname])
  @@index([visitorId])
  @@index([sessionId])
  @@index([eventId])
  @@index([country])
  @@index([region])
  @@index([city])
  @@index([visitorId, pathname, timestamp])
  @@map("analytics_events")
}

// Daily aggregated statistics — kept indefinitely
model AnalyticsDaily {
  id             String   @id @default(cuid())
  date           DateTime @unique
  uniqueVisitors Int      @default(0)
  pageViews      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@map("analytics_daily")
}
